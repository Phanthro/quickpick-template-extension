{
  "name": "quickpick-templates",
  "displayName": "QuickPick Templates",
  "description": "Apply templates .md to the selected code and copy to the clipboard.",
  "version": "0.1.2",
  "publisher": "Phanthro",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Phanthro/quickpick-template-extension"
  },
  "bugs": {
    "url": "https://github.com/Phanthro/quickpick-template-extension/issues"
  },
  "homepage": "https://github.com/Phanthro/quickpick-template-extension",
  "keywords": [
    "vscode",
    "extension",
    "templates",
    "quickpick",
    "code"
  ],
  "author": {
    "name": "Phanthro",
    "url": "https://github.com/Phanthro"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:quickpickTemplates.explainSnippetInContext",
    "onCommand:quickpickTemplates.suggestImprovements",
    "onCommand:quickpickTemplates.chooseTemplateFromFolder"
  ],
  "license": "MIT",
  "icon": "images/icon.png",
  "contributes": {
    "submenus": [
      {
        "id": "quickpickTemplates.submenu",
        "label": "QuickPick Templates"
      }
    ],
    "commands": [
      {
        "command": "quickpickTemplates.explainSnippetInContext",
        "title": "What does this snippet do in context?",
        "icon": "$(question)"
      },
      {
        "command": "quickpickTemplates.suggestImprovements",
        "title": "Improvement suggestion",
        "icon": "$(lightbulb)"
      },
      {
        "command": "quickpickTemplates.chooseTemplateFromFolder",
        "title": "Template from configured folder…",
        "icon": "$(folder-opened)"
      }
    ],
    "configuration": {
      "title": "QuickPick Templates",
      "properties": {
        "quickpickTemplates.templatesPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the folder of `.md` templates. Accepts absolute or relative path to the root of the workspace. If empty, uses the `templates` folder inside the extension."
        },
        "quickpickTemplates.language": {
          "type": "string",
          "enum": [
            "English",
            "Portuguese",
            "Spanish"
          ],
          "enumDescriptions": [
            "Responses in English",
            "Respostas em Português",
            "Respuestas en Español"
          ],
          "default": "English",
          "markdownDescription": "Language used in templates. Supported values: `English`, `Portuguese`, `Spanish`."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "submenu": "quickpickTemplates.submenu",
          "group": "navigation@50",
          "when": "editorHasSelection"
        }
      ],
      "quickpickTemplates.submenu": [
        {
          "command": "quickpickTemplates.explainSnippetInContext",
          "group": "1_quickpick@1"
        },
        {
          "command": "quickpickTemplates.suggestImprovements",
          "group": "1_quickpick@2"
        },
        {
          "command": "quickpickTemplates.chooseTemplateFromFolder",
          "group": "1_quickpick@3"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
